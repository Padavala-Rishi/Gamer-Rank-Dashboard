# --- Required: Supabase project (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- Optional: AI coach (server-side only; never prefix with NEXT_PUBLIC_) ---
# Leave empty to run without the coach. Everything else works either way.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
