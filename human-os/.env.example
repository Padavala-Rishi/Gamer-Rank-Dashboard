# Copy to .env and adjust. Never commit the real .env file.

# Port for the API server (the built client is served from the same port in production).
PORT=3001

# Path to the SQLite database file.
DATABASE_PATH=./data/human-os.db

# Set to "production" when deploying. Enables secure cookies (HTTPS only).
NODE_ENV=development

# Comma-separated origins allowed to make state-changing requests (CSRF protection).
# Defaults to the request's own host. Add your public URL when behind a proxy.
# ALLOWED_ORIGINS=https://life.example.com

# Optional: enables the AI assistant, Life Audit interpretation and goal breakdown.
# Without it, every non-AI feature (including the rule-based planner and
# "What should I do now?") still works fully.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
